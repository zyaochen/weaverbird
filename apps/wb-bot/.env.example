# --- Required for first run -------------------------------------------------
# Lark app credentials (from Feishu Open Platform → My Apps → Credentials)
LARK_APP_ID=your_lark_app_id_here
LARK_APP_SECRET=your_lark_app_secret_here

# Only fill these if your Lark app enabled message encryption / verification.
# Leave them empty otherwise.
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=

# --- Safe defaults -----------------------------------------------------------
# Weaverbird runtime data root. Default: ~/.weaverbird
WB_DATA_DIR=

# Optional default working directory used before the thread has an explicit /cwd.
# Leave empty first. Prefer explicit /cwd over widening this blindly.
WB_DEFAULT_CWD=

# Optional reverse-@ admin whitelist (comma-separated open_id values).
# Leave empty = safe default empty set = no extra admin grant.
WB_REVERSE_AT_ADMIN_OPEN_IDS=

# Optional local path to fixed code-owner approval config for F16 writeToMainBranch.
# Keep it empty by default. Point it to a local JSON file outside the repo; never commit real open_id lists.
WB_APPROVAL_CODE_OWNER_CONFIG_PATH=

# --- Agent commands ----------------------------------------------------------
# Optional command overrides if you use local wrappers instead of plain `claude` / `codex`.
# Keep them empty unless you already use wrappers in your daily shell.
# Wrapper API divergence warning: `claude-w` and `codex-w` 不是同一套参数接口.
# - `claude-w` keeps `--model <name>`
# - `codex-w` does NOT accept `--model`; use `-c model=<name>` (or `-cmodel=<name>`) instead
# If you write `codex-w --model ...`, the wrapper may fall back to its own model picker and fail in wb-bot's no-TTY backend runtime.
WB_CLAUDE_COMMAND=claude-w --model gpt-5.4
WB_CODEX_COMMAND=codex-w -c model=gpt-5.3-codex

# Optional consent mode for wb-bot's no-TTY backend runtime.
# Accepted values: normal / relaxed / auto / plan-only / strict
# In wb-bot, `strict` aliases to `plan-only` because there is no interactive TTY prompt loop.
# Leave empty to keep the default `auto`.
# WB_CLAUDE_CONSENT_LEVEL=auto

# Optional append-system-prompt passthrough for claude.
# Leave empty unless you have a very specific backend-only guidance need.
# WB_CLAUDE_APPEND_SYSTEM_PROMPT=When internal auth is required, stop early and ask the operator to authenticate first.

# --- Provider/API keys (optional; placeholders only) -------------------------
# Fill only the provider(s) you actually use. Never commit real values.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional base URLs. Leave empty for defaults.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
