{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.d.ts",
    "apps/**/*.ts",
    "apps/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "_legacy/**"
  ]
}
