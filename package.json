{
  "name": "weaverbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "wb-cli": "./apps/wb-cli/dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "dev": "tsx apps/wb-cli/src/main.ts",
    "wb-bot:dev": "tsx apps/wb-bot/src/main.ts",
    "e2e:preflight:env": "tsx apps/wb-bot/src/e2e/preflight-main.ts",
    "audit-pipe": "tsx packages/core/src/audit-pipe/audit-pipe-main.ts",
    "run-registry": "tsx packages/core/src/run-registry/run-registry-main.ts",
    "lint:codes": "tsx scripts/lint-error-codes.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
